chad_ap_sh:D10_Software_ExecutionShape a sh:NodeShape ;
    sh:property [ sh:minCount 0 ;
            sh:node chad_ap_sh:E39_ActorShape ;
            sh:path <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> ],
        [ sh:minCount 0 ;
            sh:node chad_ap_sh:E74_GroupShape ;
            sh:path <http://www.cidoc-crm.org/cidoc-crm/P11_had_participant> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node chad_ap_sh:D9_Data_ObjectShape ;
            sh:path <http://www.cidoc-crm.org/extensions/crmdig/L10_had_input> ],
        [ sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:node chad_ap_sh:E52_Time-SpanShape ;
            sh:path <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node chad_ap_sh:D9_Data_ObjectShape ;
            sh:path <http://www.cidoc-crm.org/extensions/crmdig/L11_had_output> ],
        [ sh:minCount 1 ;
            sh:node chad_ap_sh:D14_SoftwareShape ;
            sh:path <http://www.cidoc-crm.org/extensions/crmdig/L23_used_software_or_firmware> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node chad_ap_sh:E55_TypeShape ;
            sh:path <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ] ;
    sh:targetClass <http://www.cidoc-crm.org/extensions/crmdig/D10_Software_Execution> .

